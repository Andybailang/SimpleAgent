# SemanticSearch 工具配置模板
# 使用方法：复制本文件为 src/agent/semantic.env 后按需修改（semantic.env 已被 git 忽略）。
# 优先级：进程环境变量 > semantic.env > 内置默认值。
# 也可直接把同名变量写进进程环境或 src/agent/.env，引擎启动时会读取。

# 嵌入 API 地址（保持 /v1 结尾）
SEMANTIC_SEARCH_API_BASE=https://api.siliconflow.cn/v1
# API key；留空时回退到环境变量 SILICONFLOW_API_KEY
SEMANTIC_SEARCH_API_KEY=
# 嵌入模型
SEMANTIC_SEARCH_MODEL=BAAI/bge-m3
# 是否启用 semantic_search 工具（true/false）
SEMANTIC_SEARCH_ENABLED=true
# 默认返回的相似片段数
SEMANTIC_SEARCH_TOP_K=5
# 文本分块大小（字符）
SEMANTIC_SEARCH_CHUNK_SIZE=800
# 分块重叠（字符）
SEMANTIC_SEARCH_CHUNK_OVERLAP=80
# 最多扫描的文件数（超出丢弃）
SEMANTIC_SEARCH_MAX_FILES=100
# 最多嵌入的片段数（超出丢弃）
SEMANTIC_SEARCH_MAX_CHUNKS=200
# 单文件最大读取字节数（超出跳过）
SEMANTIC_SEARCH_MAX_FILE_BYTES=200000
# 嵌入 API 请求超时（秒）
SEMANTIC_SEARCH_TIMEOUT=60
